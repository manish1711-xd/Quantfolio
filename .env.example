# Quantfolio — AI-Powered Equity Research & Portfolio Terminal
# Environment Configuration Template
# Copy this file to .env and supply your personal API keys (never commit .env to version control).

# --- LLM API Configuration (Optional) ---
# If provided, the Equity Research Report Generator will enhance the executive summary
# and narrative report sections using the specified LLM. If omitted, the terminal
# uses an institutional-analyst deterministic template fallback with zero hallucination.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Market Data Configuration (Optional) ---
# Default market data provider is Yahoo Finance via yfinance (delayed, no key required).
# Alternative data providers or higher-rate tier API keys can be specified below:
# ALPHA_VANTAGE_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here

# --- Application Preferences ---
# Default base reporting currency: INR, USD, EUR, GBP
BASE_CURRENCY=INR
