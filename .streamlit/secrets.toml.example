# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
#
# `.gitignore` and `.dockerignore` both exclude `secrets.toml` (this .example
# file is the one that is committed), so your credentials stay on your machine.
# Nothing in this application ever writes a password to disk or to the SQLite
# store; these values are read at send time and discarded.
#
# Only needed for scheduled email tearsheets. Everything else works without it.

[smtp]
host = "smtp.gmail.com"

# 587 = STARTTLS, 465 = implicit SSL. The transport is inferred from the port
# unless you set `starttls` or `ssl` explicitly.
port = 587

username = "you@example.com"

# An APP-SPECIFIC password, not your account password. Gmail and Outlook both
# reject an account password for SMTP; the app tells you so by name when the
# server refuses the login.
#   Gmail:   https://myaccount.google.com/apppasswords
#   Outlook: Security > Advanced security options > App passwords
password = "xxxx xxxx xxxx xxxx"

# Defaults to `username` if omitted.
sender = "you@example.com"

# Optional display name: "QuantFolio <you@example.com>".
sender_name = "QuantFolio"

# Optional. Seconds to wait on an unresponsive server before giving up.
# timeout = 30

# ---------------------------------------------------------------------------
# A scheduled run started by cron or Task Scheduler does not read this file.
# Give the same values to that process as environment variables instead:
#
#   SMTP_HOST  SMTP_PORT  SMTP_USERNAME  SMTP_PASSWORD  SMTP_SENDER
#   SMTP_SENDER_NAME  SMTP_STARTTLS  SMTP_SSL  SMTP_TIMEOUT
#
# Verify with:  python -m src.reporting.cli --dry-run
# ---------------------------------------------------------------------------
